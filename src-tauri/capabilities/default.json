{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "connectivity:default",
    "notification:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "notify-send", "cmd": "notify-send", "args": true }
      ]
    }
  ]
}